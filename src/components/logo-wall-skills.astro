---
const technologies = [
  "HTML5",
  "CSS3",
  "Tailwind CSS",
  "Bootstrap",
  "MUI",
  "JavaScript",
  "TypeScript",
  "React",
  "Vite",
  "Next.js",
  "Redux",
  "Express",
  "Node.js",
  "Python",
  "Django",
  "Csharp",
  "dotNET",
  "Blazor",
  "PHP",
  "Docker",
  "Kubernetes",
  "OpenShift",
  "MySQL",
  "SQLite",
  "GraphQL",
  "MongoDB",
  "Git",
  "GitHub",
  "GitHub Copilot",
  "Figma",
  "Astro",
  "Expo",
  "C++",
  "Unreal Engine",
  "Twinmotion",
];
---

<style is:global>
  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>

<div class="relative overflow-x-hidden py-8">
  <div class="pointer-events-none absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-[var(--bg)] to-transparent z-20"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-[var(--bg)] to-transparent z-20"></div>

  <div class="flex animate-scroll hover:animate-paused gap-12 md:gap-20 w-max">
    {[...technologies, ...technologies, ...technologies].map((tech) => (
      <div class="flex items-center gap-2 group transition-all duration-300">
        <img
          src={`/svg/${tech}.svg`}
          alt={tech}
          class="h-7 w-auto object-contain transition-transform group-hover:scale-110 opacity-60"
          width="30"
          height="30"
          loading="lazy"
        />
        <span class="text-lg font-medium text-[var(--white-icon)]">
            {tech === "Csharp" ? "C#" : tech === "dotNET" ? ".NET" : tech}
        </span>
      </div>
    ))}
  </div>
</div>

<style>
  :root {
    --bg: #111;
  }
  
  .animate-scroll {
    animation: scroll 120s linear infinite;
  }
  
  @media (min-width: 768px) {
    .animate-scroll {
      animation-duration: 60s;
    }
  }
</style>