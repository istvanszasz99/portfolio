---
import { Image } from "astro:assets";
import { GitHubDark } from "@ridemountainpig/svgl-react";
import pic_backend from "../../public/image/pic_backend.png";
import pic_university from "../../public/image/pic_university.png";
import pic_reactnative from "../../public/image/pic_reactnative.png";
import pic_frontend from "../../public/image/pic_frontend.png";

interface Project {
  title: string;
  image: ImageMetadata;
  link: string;
  status: string;
}

const projects: Project[] = [
  {
    title: "Meta Back-End Developer Certification Capstone",
    image: pic_backend as ImageMetadata,
    link: "https://github.com/istvanszasz99/Meta_Back-End_Developer_Professional_Certificate_Back-End_Developer_Capstone_Portfolio_Project",
    status: "Web Development",
  },
  {
    title: "Meta Front-End Developer Certification Capstone",
    image: pic_frontend as ImageMetadata,
    link: "https://github.com/istvanszasz99/Meta_Front-End_Developer_Professional_Certificate_Front-End_Developer_Capstone_Portfolio_Project",
    status: "Web Development",
  },
  {
    title: "Meta React Native Specialization Capstone",
    image: pic_reactnative as ImageMetadata,
    link: "https://github.com/istvanszasz99/Meta_React_Native_Specialization_Capstone_React_App_Portfolio_Project",
    status: "Mobile Development",
  },
  {
    title: "Simulation of the University Campus in 3D Environment",
    image: pic_university as ImageMetadata,
    link: "https://github.com/istvanszasz99/ObudaUniverityThesis",
    status: "3D Development",
  },
];
---

<section id="projects" class="py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-5xl mx-auto">
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Projects</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projects.map((project) => (
          <div class="group">
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="block"
            >
              <div class="rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300 mb-4">
                <Image
                  src={project.image}
                  alt={project.title}
                  class="w-full h-48 md:h-72 object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </div>
              <div class="flex items-center">
                <div class="flex-grow">
                  <h4 class="text-2xl font-semibold">{project.title}</h4>
                  <span class="py-1 text-sm text-[var(--white-icon)]">
                    {project.status}
                  </span>
                </div>
                <div class="flex gap-2 ml-auto">
                  <a 
                    target="_blank" 
                    href={project.link} 
                    aria-label="GitHub" 
                    class="size-14 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-7">
                      <path d="M24 12L18.3431 17.6569L16.9289 16.2426L21.1716 12L16.9289 7.75736L18.3431 6.34315L24 12ZM2.82843 12L7.07107 16.2426L5.65685 17.6569L0 12L5.65685 6.34315L7.07107 7.75736L2.82843 12ZM9.78845 21H7.66009L14.2116 3H16.3399L9.78845 21Z"></path>
                    </svg>
                  </a>
                </div>
              </div>
            </a>
          </div>
        ))
      }
    </div>
    <a
      target="_blank"
      href="https://github.com/istvanszasz99?tab=repositories"
      aria-label="GitHub"
      class="w-full flex items-center justify-center gap-2 mt-9 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
    >
      <span class="md:text-lg text-md">More projects on</span>
      <GitHubDark width={24} height={24} />
    </a>
  </div>
</section>