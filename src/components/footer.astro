---
import {
  AstroLight,
  TailwindCSS,
  Cloudflare,
  GitHubDark,
  LinkedIn,
} from "@ridemountainpig/svgl-react";

type SvglIcon = (props: { width: number; height: number; class?: string }) => any;
---

<footer class="w-full py-12 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
      <div class="flex flex-col lg:items-start items-center justify-center space-y-6 gap-9">
        <div class="flex space-x-6 sm:space-x-8">
          {[
            { 
              href: "https://github.com/istvanszasz99",
              component: GitHubDark,
              label: "GitHub"
            },
            {
              href: "https://linkedin.com/in/istvanszasz99",
              component: LinkedIn,
              label: "LinkedIn"
            },
            {
              href: "https://mail.google.com/mail/?view=cm&fs=1&to=istvanszasz99@gmail.com",
              component: null,
              icon: '<svg xmlns="http://www.w3.org/2000/svg" width="2.1em" height="2.1em" viewBox="0 0 24 24"><path fill="currentColor" d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"/></svg>',
              label: "Email"
            }
          ].map((link) => (
            <a
              href={link.href}
              target="_blank"
              class="flex flex-col items-center group"
              aria-label={link.label}
            >
              <div class="text-[var(--white-icon)] hover:text-[var(--white)]">
                {link.component ? (
                  <link.component width={32} height={32} class="size-8" />
                ) : (
                  <div set:html={link.icon}></div>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>

      <div class="flex flex-col items-center space-y-6">
        <div class="grid grid-cols-1 gap-3 w-full max-w-xs mx-auto">
          {[
        { 
          desc: "Built with",
          name: "Astro",
          component: AstroLight as SvglIcon
        },
        {
          desc: "Styled with",
          name: "Tailwind CSS",
          component: TailwindCSS as SvglIcon
        },
        {
          desc: "Deployed on",
          name: "Cloudflare",
          component: Cloudflare as SvglIcon
        }
          ].map((tech) => (
        <div class="flex items-center justify-center space-x-3">
          <span class="text-[var(--white-icon)] text-sm">{tech.desc}</span>
          <tech.component
            width={20}
            height={20}
            class="h-5 w-5 object-contain opacity-50"
          />
          <span class="text-[var(--white-icon)] text-sm">{tech.name}</span>
        </div>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-[#ffffff10]">
      <p class="text-center text-sm text-[var(--white-icon)] space-y-2">
        <span class="block sm:inline">© {new Date().getFullYear()} Portfolio. All rights reserved.</span>
      </p>
    </div>
  </div>
</footer>